# ---- Public (exposed to the browser) ----
# Supabase project URL and anon key. Find these in:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---- Server-only (never exposed to the browser) ----
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string).
# Use the pooled connection (port 6543) for serverless.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Optional: Supabase service role key for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Mistral API key used by the statement OCR upload endpoint.
MISTRAL_API_KEY=""
